# OpenAI Gateway configuration for Supply Chain Risk Intelligence Assistant
GATEWAY_URL=https://keygateway1.arshnivlabs.com
LEARNER_KEY=pubatch_trainer
OPENAI_API_BASE=https://keygateway1.arshnivlabs.com/v1
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Data and Artifacts
DATA_PATH=data/dataset.csv
MODELS_DIR=artifacts/models
REPORTS_DIR=reports

# ML & Scoring Settings
DELIVERY_RISK_THRESHOLD=0.5
ANOMALY_CONTAMINATION=0.03
FORECAST_HORIZON_DAYS=30
SAFETY_STOCK_Z=1.65

# Server
HOST=127.0.0.1
PORT=8000
